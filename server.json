{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.gotoquill/gotoquill",
  "title": "gotoquill",
  "description": "Human-confirmed PDF signing. Local stdio via PyPI; hosted Cloud with OAuth.",
  "version": "0.2.0",
  "websiteUrl": "https://gotoquill.com/docs/connect/",
  "repository": {
    "url": "https://github.com/gotoquill/gotoquill",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "gotoquill",
      "version": "0.2.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Run the local stdio MCP server"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.gotoquill.com/mcp"
    }
  ]
}
